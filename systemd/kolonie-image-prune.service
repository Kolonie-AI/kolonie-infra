[Unit]
Description=Remove application images no longer worth keeping (kolonie-infra#91)
# It talks to the Docker daemon and to nothing else, so it has to wait for one.
# On a boot where Docker is slow to come up this orders the run after it rather
# than racing it.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# **`RemainAfterExit` is left at its default of `no`, and that is #65.**
# systemd will not schedule the next elapse of a timer whose triggered unit is
# still active, so a `yes` here would give a timer that reads healthy on every
# signal anybody thinks to check and never fires again. That failure cost
# `kolonie-origin-firewall.timer` three days and was found by hand.
ExecStart=/opt/kolonie/scripts/image-prune.sh
StateDirectory=kolonie

# The margin is one day of builds, so a daily prune never removes an image built
# on the day it runs.
#
# It was 5 until `#218`, and the intent written here then — *larger than the
# number of builds a busy day produces between two runs* — no longer matched the
# number. Measured on the deploy host on 2026-08-19: about 50 builds per
# repository per day, so five builds is roughly two hours.
#
# Weekly pruning hid that. Between two Sunday passes several hundred images
# accumulated and the deep history was there whether or not this margin was
# generous; a daily pass makes it the binding constraint for the first time.
#
# Fifty costs about 26 GB of steady state at roughly 75 MB of unshared layers per
# image — 350 images across seven repositories — on a 96 GB partition that grows
# 23 GB a day. Peak stays near half, well under the 85 % the pressure report
# alarms on.
Environment=KEEP_BUILDS=50

# It reads the deploy records and writes image-prune.env under /var/lib/kolonie
# after success. StateDirectory keeps root-owned runtime state out of the Git
# checkout, where it would obstruct deploy.sh's reset of /opt/kolonie.
ProtectHome=true
NoNewPrivileges=true

# A prune that could not run is not an incident on the day it happens — the
# partition fills over days rather than hours, and the next pass will try again. What
# must not happen is a unit retrying in a tight loop against a daemon that is
# already struggling for space.
Restart=no

[Install]
WantedBy=multi-user.target
