[Unit]
Description=Hourly deposit reconciliation (kolonie-infra#72)
# Hourly, and the interval is an argument rather than a default. A deposit the
# webhook delivered is credited in seconds; this exists for the ones it did not,
# and an hour is well inside the patience of somebody who has just sent money
# and can watch it land on-chain. It is also cheap — one RPC call per deposit
# address — so the cost of being wrong about the interval is small in the
# direction of running it more often, and a lost deposit in the other.

[Timer]
OnCalendar=hourly
# A pass skipped because the host was down is the one most likely to matter: an
# outage is exactly when a webhook delivery would have been dropped. Persistent
# runs it once on the next boot rather than waiting for the next hour.
Persistent=true
# The public RPC endpoint is rate-limited per source address and every other
# hourly timer on this box would otherwise fire at :00 together. Five minutes is
# enough to separate them and short enough that the hour still means an hour.
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
