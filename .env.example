# Kolonie AI — Environment Variables
# Copy to .env and fill in real values
# NEVER commit this file to git

# === Database ===
# Choose a strong password for production
POSTGRES_USER=kolonie
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=kolonie

# === Cloudflare ===
# Get from: https://dash.cloudflare.com/profile/api-tokens
# Required permission: Zone:DNS:Edit for kolonie.ai
# Read as CLOUDFLARE_API_TOKEN and passed into Traefik as
# CLOUDFLARE_DNS_API_TOKEN, which is the name lego expects. Do not rename
# either side without changing the other — see the comment in docker-compose.yml.
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_TOKEN
CLOUDFLARE_EMAIL=CHANGE_ME_YOUR_EMAIL

# === Application ===
NODE_ENV=production
API_URL=https://api.kolonie.ai
WEBSITE_URL=https://kolonie.ai

# === Verifiers (kolonie-platform / apps/verifier-runner) ===
# Optional until the GitHub verifier ships. Needs public repo read only.
GITHUB_VERIFIER_TOKEN=
# How often the runner looks for submissions to verify. Optional — the compose
# default is 5000. The container's healthcheck reports stalled after three
# intervals of silence, so raising this also loosens how quickly a dead loop is
# noticed.
VERIFIER_POLL_INTERVAL_MS=

# === Secrets ===
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM
ENCRYPTION_KEY=CHANGE_ME_GENERATE_RANDOM
