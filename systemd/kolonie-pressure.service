[Unit]
Description=Publish whether this host is under resource pressure (kolonie-infra#103)
# It reads Docker's container states through health-report.sh, so there has to be
# a daemon. On a boot where Docker is slow this orders the run after it rather
# than racing it — and a run that could not read is published as *degraded*, so
# racing would raise a real alarm about nothing.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/kolonie/scripts/pressure-report.sh
StateDirectory=kolonie

# It writes one file under /var/lib/kolonie/public and reads the Docker socket
# and the deploy records. StateDirectory keeps root-owned runtime state out of
# the Git checkout, where it would obstruct deploy.sh's reset of /opt/kolonie —
# kolonie-infra#119 is what happens when this line is missing on the host.
ProtectHome=true
NoNewPrivileges=true

# A publish that could not run is not an incident on the day it happens: the file
# it did not rewrite is the *previous* verdict, and the next elapse is five
# minutes away. What must not happen is a unit retrying in a tight loop against a
# daemon that is already struggling.
# **A pass that hangs must fail, not stall the timer** (`#222`).
#
# systemd will not schedule the next elapse of a timer whose service is still
# active — the same mechanism `kolonie-image-prune.service` writes down for
# `#65`. Without a bound here, one hung pass stops this host's disk, inode and
# backup watchers for as long as it hangs, and `#221` showed the shape: the timer
# reports active, enabled and last-run-successful the whole time.
#
# 240 seconds. Under the 300-second interval, so the next elapse is always
# schedulable. Four times the worst pass measured on the deploy host on
# 2026-08-19 — 58.2s, 55.1s, 52.6s, 50.2s, 49.9s over six hours — so an
# ordinarily slow pass is not killed.
#
# A killed pass is the right outcome and the reason the number is not simply
# raised until nothing fails: `pressure-report.sh` publishes a keyword and
# UptimeRobot alarms on its absence, so a timeout leaves the file unrefreshed and
# the alarm fires. Loud failure is the design; a stalled timer is the silent one.
TimeoutStartSec=240

Restart=no

[Install]
WantedBy=multi-user.target
